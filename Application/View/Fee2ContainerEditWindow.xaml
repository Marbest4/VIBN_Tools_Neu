<Window x:Class="VIBN_Tools.Application.View.Fee2ContainerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FEE2Container – Bearbeiten und Grouping" Width="1200" Height="760"
        MinWidth="600" MinHeight="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Grouping wie in ContainerGeneration (Capture-Gruppen in Regex; mehrere Muster mit Komma und Leerzeichen trennen)" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,8">
                <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="Component" IsChecked="{Binding Settings.GroupByComponent}"/>
                <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="Typ" IsChecked="{Binding Settings.GroupByType}"/>
                <CheckBox Margin="0,0,6,0" VerticalAlignment="Center" Content="ID" IsChecked="{Binding Settings.GroupById}"/>
                <TextBox Width="170" Margin="0,0,12,0" Text="{Binding Settings.RegexId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Beispiel: ^([^.]+)"/>
                <CheckBox Margin="0,0,6,0" VerticalAlignment="Center" Content="Adresse" IsChecked="{Binding Settings.GroupByAddress}"/>
                <TextBox Width="170" Margin="0,0,12,0" Text="{Binding Settings.RegexAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="Beispiel: ^%([IQ][0-9]+)"/>
                <Button Content="Grouping-Vorschau" Padding="10,5" Click="CommitTables" Command="{Binding GroupCommand}"/>
            </WrapPanel>
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Container">
                <DataGrid ItemsSource="{Binding Editor.Containers}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Export" Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Containername" Binding="{Binding Component, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                        <DataGridTemplateColumn Header="Typ" Width="*">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.SupportedContainerTypes, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="False" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="FEE-Objekte (GUIDs und Typen im XML)" Binding="{Binding AssociatedObjects}" IsReadOnly="True" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Signale und Slots">
                <DataGrid ItemsSource="{Binding Editor.Signals}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Export" Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Container" Binding="{Binding Container}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="ID" Binding="{Binding SignalId, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="Signal" Binding="{Binding Signal, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                        <DataGridTextColumn Header="Slot" Binding="{Binding Slot, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="Adresse" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="Datentyp" Binding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="Hinweis" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="ContainerFile XML / FEE-Zuordnungen">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,6">
                        <Button Margin="0,0,8,0" Padding="10,5" Content="Tabellen → XML" Click="CommitTables" Command="{Binding WriteXmlCommand}"/>
                        <Button Padding="10,5" Content="XML → Tabellen" Click="CommitTables" Command="{Binding ReadXmlCommand}"/>
                    </WrapPanel>
                    <TextBox Text="{Binding Xml, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                </DockPanel>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Margin="0,10" Text="{Binding Status}" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Padding="15,7" Content="Übernehmen" Click="Apply_Click"/>
            <Button Padding="15,7" Content="Abbrechen" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
