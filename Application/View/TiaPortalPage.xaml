<UserControl x:Class="VIBN_Tools.Application.View.TiaPortalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grob.UX;component/Styles/General.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="TIA Portal" Style="{StaticResource H1Style}" />

        <StackPanel Grid.Row="1" Margin="0,16,0,12" Orientation="Horizontal">
            <ComboBox Width="140"
                      ItemsSource="{Binding InstalledVersions}"
                      SelectedItem="{Binding SelectedVersion}" />
            <Button MinWidth="170"
                    Margin="8,0,0,0"
                    Content="Verbinden und öffnen"
                    Command="{Binding ConnectCommand}" />
            <ComboBox Width="300"
                      Margin="24,0,0,0"
                      ItemsSource="{Binding Plcs}"
                      SelectedItem="{Binding SelectedPlc}"
                      DisplayMemberPath="Name" />
            <Button MinWidth="120"
                    Margin="8,0,0,0"
                    Content="PLC auswählen"
                    Command="{Binding SelectPlcCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <GroupBox Header="Simulationsachsen" Margin="0,0,0,10">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="250" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
                        <Button MinWidth="135"
                                Content="Achsen nur lesen"
                                ToolTip="Liest die Achsenliste, ohne das TIA-Projekt zu verändern."
                                Command="{Binding LoadAxesCommand}" />
                        <Button MinWidth="170"
                                Margin="8,0,0,0"
                                Content="Auswahl konfigurieren"
                                ToolTip="Setzt ausschließlich bei den ausgewählten Achsen die dokumentierten Simulationsparameter."
                                Command="{Binding ConfigureAxesCommand}" />
                        <Button MinWidth="245"
                                Margin="8,0,0,0"
                                Content="Konfigurieren + AxisDB/AxisFC erzeugen"
                                ToolTip="Konfiguriert ausgewählte gefundene Achsen und nimmt markierte bereits konfigurierte Achsen in AxisDB.xml/AxisFC.xml auf."
                                Command="{Binding ConfigureAxesAndCreateFilesCommand}" />
                        <Button MinWidth="65" Margin="8,0,0,0" Content="Alle" Command="{Binding SelectAllAxesCommand}" />
                        <Button MinWidth="65" Margin="8,0,0,0" Content="Keine" Command="{Binding SelectNoAxesCommand}" />
                        <Button MinWidth="145" Margin="8,0,0,0" Content="Was wird geändert?"
                                Command="{Binding ToggleAxisConfigurationInfoCommand}" />
                    </WrapPanel>

                    <Border Grid.Row="1" Margin="0,0,0,8" Padding="8" Background="#FFF3F5F7" CornerRadius="3"
                            Visibility="{Binding IsAxisConfigurationInfoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding AxisConfigurationInfo}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding ProjectSaveInfo}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="AxisDB/AxisFC-Ablagewurzel"
                                   ToolTip="Es werden die Unterordner _Programm\Axis angelegt. Das entspricht dem bisherigen Avalonia-Ablauf." />
                        <TextBox Grid.Column="1" Margin="8,0" Text="{Binding AxisArtifactPath}"
                                 ToolTip="Projekt- oder Kundenordner auswählen. Ausgabe: &lt;Ordner&gt;\_Programm\Axis\AxisDB.xml und AxisFC.xml" />
                        <Button Grid.Column="2" MinWidth="110" Content="Durchsuchen"
                                Command="{Binding BrowseAxisArtifactCommand}" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="1. Gefundene Achsen (nur gelesen)">
                            <DataGrid ItemsSource="{Binding FoundAxes}" AutoGenerateColumns="False"
                                      IsReadOnly="False" EnableRowVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Ändern" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                                    <DataGridTextColumn Header="Achse" Binding="{Binding Name, Mode=OneWay}" Width="140" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Gruppe" Binding="{Binding GroupPath, Mode=OneWay}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Typ" Binding="{Binding TechnologyType, Mode=OneWay}" Width="140" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="2. Erfolgreich konfigurierte Achsen">
                            <DataGrid ItemsSource="{Binding ConfiguredAxes}" AutoGenerateColumns="False"
                                      IsReadOnly="False" EnableRowVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="In Dateien" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                                    <DataGridTextColumn Header="Achse" Binding="{Binding Name, Mode=OneWay}" Width="140" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Gruppe" Binding="{Binding GroupPath, Mode=OneWay}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Ergebnis" Binding="{Binding Result, Mode=OneWay}" Width="190" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>

                    <DockPanel Grid.Row="4" Margin="0,8,0,0">
                        <ProgressBar Width="250" Height="8" Minimum="0" Maximum="100"
                                     VerticalAlignment="Center" Value="{Binding OperationProgress, Mode=OneWay}" />
                        <Button MinWidth="190" Margin="8,0,0,0" HorizontalAlignment="Right"
                                Content="Gesamtes TIA-Projekt speichern"
                                ToolTip="Ruft Project.Save() auf und speichert alle derzeit offenen Projektänderungen. Nur erforderlich, wenn diese dauerhaft erhalten bleiben sollen."
                                Command="{Binding SaveCommand}" />
                    </DockPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="ViCo-Bibliothek" Margin="0,0,0,10">
                <Grid Margin="8" MinHeight="260">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="2" MinWidth="155" Margin="0,0,0,8"
                            Content="Was wird gemacht?" Command="{Binding ToggleLibraryOperationInfoCommand}" />

                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10" Padding="10"
                            Background="#FFF3F5F7" CornerRadius="3"
                            Visibility="{Binding IsLibraryOperationInfoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding LibraryOperationInfo}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="1. Exportordner" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="8,4" Text="{Binding ExportPath}" />
                    <Button Grid.Row="2" Grid.Column="2" MinWidth="110" Content="Durchsuchen" Command="{Binding BrowseExportCommand}" />

                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,8">
                        <TextBlock Text="TIA-Bibliotheksordner" />
                        <TextBox Margin="0,4,0,0" Text="{Binding LibraryName}" />
                    </StackPanel>
                    <Button Grid.Row="3"
                            Grid.Column="2"
                            MinWidth="150"
                            Content="Bibliothek exportieren"
                            Command="{Binding ExportLibraryCommand}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="2. Importordner" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="8,4" Text="{Binding LibraryPath}" />
                    <Button Grid.Row="4" Grid.Column="2" MinWidth="110" Content="Durchsuchen"
                            ToolTip="Ordner mit den Unterordnern _Programm und _Datatype auswählen."
                            Command="{Binding BrowseImportCommand}" />

                    <ProgressBar Grid.Row="5" Grid.Column="1" Height="8" Margin="8,12"
                                 Minimum="0" Maximum="100" Value="{Binding OperationProgress, Mode=OneWay}" />
                    <Button Grid.Row="5" Grid.Column="2" MinWidth="150"
                            Content="Bibliothek importieren" Command="{Binding ImportLibraryCommand}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Achsen-Austausch (TiaBridge Rev23)">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Austauschordner" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="8,4" Text="{Binding AxisExchangePath}" />
                    <Button Grid.Row="0" Grid.Column="2" MinWidth="110" Content="Durchsuchen"
                            Command="{Binding BrowseAxisExchangeCommand}" />

                    <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8">
                        <Button DockPanel.Dock="Right" MinWidth="155" Content="Was wird gemacht?"
                                Command="{Binding ToggleAxisExchangeInfoCommand}" />
                        <TextBlock Margin="0,0,12,0" Text="Export, Import und Schnittstellendatei für Technologieachsen"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8" Padding="8"
                            Background="#FFF3F5F7" CornerRadius="3"
                            Visibility="{Binding IsAxisExchangeInfoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding AxisExchangeInfo}" TextWrapping="Wrap" />
                    </Border>

                    <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Right">
                        <Button MinWidth="185" Content="TO-Konfiguration exportieren"
                                ToolTip="Liest alle Achsenparameter und schreibt sie in den Austauschordner."
                                Command="{Binding ExportAxisConfigurationsCommand}" />
                        <Button MinWidth="185" Margin="8,0,0,0" Content="TO-Konfiguration importieren"
                                ToolTip="Ändert passende Achsenparameter. Speichert das TIA-Projekt nicht automatisch."
                                Command="{Binding ImportAxisConfigurationsCommand}" />
                        <Button MinWidth="185" Margin="8,0,0,0" Content="Achsen-Schnittstelle erzeugen"
                                ToolTip="Erzeugt AxisValueTags.xlsx; das TIA-Projekt bleibt unverändert."
                                Command="{Binding ExportAxisInterfaceCommand}" />
                    </WrapPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="TIA Quality Gate" Margin="0,10,0,0">
                <Grid Height="260" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" MinWidth="185"
                                Content="Ausgewählte PLC kompilieren"
                                Command="{Binding CompileQualityGateCommand}" />
                        <TextBlock Margin="0,0,16,0" Text="{Binding CompileQualityGateInfo}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Grid.Row="1" Height="8" Margin="0,0,0,8"
                                 Minimum="0" Maximum="100" Value="{Binding OperationProgress, Mode=OneWay}" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding CompileMessages}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="2*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="120" />
                            <DataGridTextColumn Header="Fehler" Binding="{Binding ErrorCount}" Width="65" />
                            <DataGridTextColumn Header="Warnungen" Binding="{Binding WarningCount}" Width="85" />
                            <DataGridTextColumn Header="Meldung" Binding="{Binding Description}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Header="Programmbausteine und Datentypen" Margin="0,10,0,0">
                <Grid Height="230" Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <Button MinWidth="150" Content="Bausteine laden" Command="{Binding LoadBlocksCommand}" />
                        <Button MinWidth="150" Margin="8,0,0,0" Content="Datentypen laden" Command="{Binding LoadDataTypesCommand}" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ProgramItems}" AutoGenerateColumns="False"
                              IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="240" />
                            <DataGridTextColumn Header="Ordner" Binding="{Binding FolderPath, Mode=OneWay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar DockPanel.Dock="Right"
                         Width="160"
                         Height="6"
                         Margin="12,0,0,0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" />
        </DockPanel>
    </Grid>
</UserControl>
