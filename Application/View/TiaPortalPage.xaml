<UserControl x:Class="VIBN_Tools.Application.View.TiaPortalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grob.UX;component/Styles/General.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="TIA Portal" Style="{StaticResource H1Style}" />

        <StackPanel Grid.Row="1" Margin="0,16,0,12" Orientation="Horizontal">
            <ComboBox Width="140"
                      ItemsSource="{Binding InstalledVersions}"
                      SelectedItem="{Binding SelectedVersion}" />
            <Button MinWidth="170"
                    Margin="8,0,0,0"
                    Content="Verbinden und öffnen"
                    Command="{Binding ConnectCommand}" />
            <ComboBox Width="300"
                      Margin="24,0,0,0"
                      ItemsSource="{Binding Plcs}"
                      SelectedItem="{Binding SelectedPlc}"
                      DisplayMemberPath="Name" />
            <Button MinWidth="120"
                    Margin="8,0,0,0"
                    Content="PLC auswählen"
                    Command="{Binding SelectPlcCommand}" />
        </StackPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="Projektübersicht">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Programmbausteine und Datentypen">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
                        <Button MinWidth="150"
                                Content="Bausteine laden"
                                Command="{Binding LoadBlocksCommand}" />
                        <Button MinWidth="150"
                                Margin="8,0,0,0"
                                Content="Datentypen laden"
                                Command="{Binding LoadDataTypesCommand}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ProgramItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="240" />
                            <DataGridTextColumn Header="Ordner" Binding="{Binding FolderPath, Mode=OneWay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Simulationsachsen">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
                        <Button MinWidth="135"
                                Content="Achsen nur lesen"
                                ToolTip="Liest die Achsenliste, ohne das TIA-Projekt zu verändern."
                                Command="{Binding LoadAxesCommand}" />
                        <Button MinWidth="170"
                                Margin="8,0,0,0"
                                Content="Auswahl konfigurieren"
                                ToolTip="Setzt ausschließlich bei den ausgewählten Achsen die dokumentierten Simulationsparameter."
                                Command="{Binding ConfigureAxesCommand}" />
                        <Button MinWidth="65" Margin="8,0,0,0" Content="Alle" Command="{Binding SelectAllAxesCommand}" />
                        <Button MinWidth="65" Margin="8,0,0,0" Content="Keine" Command="{Binding SelectNoAxesCommand}" />
                        <Button MinWidth="145" Margin="8,0,0,0" Content="Was wird geändert?"
                                Command="{Binding ToggleAxisConfigurationInfoCommand}" />
                    </WrapPanel>

                    <Border Grid.Row="1" Margin="0,0,0,8" Padding="8" Background="#FFF3F5F7" CornerRadius="3"
                            Visibility="{Binding IsAxisConfigurationInfoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding AxisConfigurationInfo}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding ProjectSaveInfo}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Axes}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Ändern" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                            <DataGridTextColumn Header="Achse" Binding="{Binding Name, Mode=OneWay}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Gruppe" Binding="{Binding GroupPath, Mode=OneWay}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding TechnologyType, Mode=OneWay}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Ergebnis" Binding="{Binding Result, Mode=OneWay}" Width="190" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="3"
                            MinWidth="150"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Content="Gesamtes TIA-Projekt speichern"
                            ToolTip="Ruft Project.Save() auf und speichert alle derzeit offenen Projektänderungen. Nur erforderlich, wenn diese dauerhaft erhalten bleiben sollen."
                            Command="{Binding SaveCommand}" />
                </Grid>
            </GroupBox>
        </Grid>
            </TabItem>

            <TabItem Header="ViCo-Bibliothek">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="2" MinWidth="155" Margin="0,0,0,8"
                            Content="Was wird gemacht?" Command="{Binding ToggleLibraryOperationInfoCommand}" />

                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10" Padding="10"
                            Background="#FFF3F5F7" CornerRadius="3"
                            Visibility="{Binding IsLibraryOperationInfoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding LibraryOperationInfo}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Importordner" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="8,4" Text="{Binding LibraryPath}" />
                    <Button Grid.Row="2" Grid.Column="2" MinWidth="110" Content="Durchsuchen" ToolTip="Ordner mit den Unterordnern _Programm und _Datatype auswählen." Command="{Binding BrowseImportCommand}" />

                    <CheckBox Grid.Row="3"
                              Grid.Column="1"
                              Margin="8,8"
                              Content="Achsen konfigurieren und AxisDB/AxisFC erzeugen"
                              ToolTip="Konfiguriert beim Import alle gefundenen Achsen und erzeugt viCo_Axes_DB sowie viCo_AxisConnect_FC. Für eine Auswahl zuerst die Projektübersicht verwenden."
                              IsChecked="{Binding ConfigureAxesDuringImport}" />
                    <Button Grid.Row="3"
                            Grid.Column="2"
                            MinWidth="150"
                            Content="Bibliothek importieren"
                            Command="{Binding ImportLibraryCommand}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Exportordner" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="8,4" Text="{Binding ExportPath}" />
                    <Button Grid.Row="4" Grid.Column="2" MinWidth="110" Content="Durchsuchen" Command="{Binding BrowseExportCommand}" />

                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="8,16,8,0">
                        <TextBlock Text="TIA-Bibliotheksordner" />
                        <TextBox Margin="0,4,0,12" Text="{Binding LibraryName}" />
                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding OperationProgress, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Row="5"
                            Grid.Column="2"
                            MinWidth="150"
                            Margin="0,16,0,0"
                            VerticalAlignment="Top"
                            Content="Bibliothek exportieren"
                            Command="{Binding ExportLibraryCommand}" />
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar DockPanel.Dock="Right"
                         Width="160"
                         Height="6"
                         Margin="12,0,0,0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" />
        </DockPanel>
    </Grid>
</UserControl>
