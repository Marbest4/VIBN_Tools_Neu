<Window x:Class="VIBN_Tools.Application.View.ContainerFileComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ContainerFiles – Vergleich und Änderungsübersicht" Width="1400" Height="850"
        MinWidth="950" MinHeight="600" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
        <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="Black"/></Style>
        <Style TargetType="Button"><Setter Property="Margin" Value="0,0,8,6"/><Setter Property="Padding" Value="10,6"/></Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsDifferent}" Value="True">
                <Setter Property="Background" Value="#FFFFE5AD"/>
            </DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel>
            <Button Content="Alte Datei öffnen" Command="{Binding OpenOldCommand}"/>
            <Button Content="Aktuellen FEE-Stand lesen" Command="{Binding ReadFeeCommand}"/>
            <Button Content="Neue Datei öffnen" Command="{Binding OpenNewCommand}"/>
            <Button Content="Änderungen auswählen" Command="{Binding SelectChangesCommand}"/>
            <Button Content="Auswahl leeren" Command="{Binding ClearSelectionCommand}"/>
            <Button Content="Geprüften Stand speichern" Command="{Binding SaveReviewedCommand}"/>
            <Button Content="Auswahl auf FEE anwenden" Command="{Binding ApplyCommand}" FontWeight="SemiBold"/>
        </WrapPanel>
        <Grid Grid.Row="1">
            <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers></Style></Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Anwenden" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                    <DataGridTextColumn Header="Container" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Änderung" Binding="{Binding KindText}" Width="140" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="6"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                <Grid Margin="8,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding OldLabel}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding NewLabel}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </Grid>
                <TabControl Grid.Row="1">
                    <TabItem Header="Container – Zeilenvergleich">
                        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Eintrag / Feld" Binding="{Binding Path}" Width="230"/>
                                <DataGridTextColumn Header="Alt / aktueller FEE-Stand" Binding="{Binding OldValue}" Width="*"/>
                                <DataGridTextColumn Header="Neu" Binding="{Binding NewValue}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Verfügbarer Bestand">
                        <DataGrid ItemsSource="{Binding InventoryRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Eintrag / Feld" Binding="{Binding Path}" Width="230"/>
                                <DataGridTextColumn Header="Alt" Binding="{Binding OldValue}" Width="*"/>
                                <DataGridTextColumn Header="Neu" Binding="{Binding NewValue}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <GroupBox Grid.Row="3" Header="Neuen Container bearbeiten – Signale, GUIDs, FEE-Typen und Zuordnungen">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Content="XML-Bearbeitung übernehmen und Vergleich aktualisieren" Command="{Binding CommitEditsCommand}"/>
                        <TextBox Text="{Binding EditedXml, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="{Binding Status}" TextWrapping="Wrap"/>
    </Grid>
</Window>
