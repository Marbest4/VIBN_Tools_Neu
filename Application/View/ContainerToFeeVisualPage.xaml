<UserControl x:Class="VIBN_Tools.Application.View.ContainerToFeeVisualPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:VIBN_Tools.Application.Behaviors"
             xmlns:vm="clr-namespace:VIBN_Tools.Application.VM"
             xmlns:visual="clr-namespace:VIBN_Tools.ContainerToFeeVisual"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1700">

    <UserControl.DataContext>
        <vm:ContainerToFeeVisualPageVM />
    </UserControl.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black" />
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="VisualPanelHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="VisualToolbarButton" TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style x:Key="VisualTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTip">
                <Setter.Value>
                    <StackPanel>
                        <TextBlock Text="{Binding TypeName, StringFormat=Typ: {0}}" />
                        <TextBlock Text="{Binding Slot, StringFormat=Slot: {0}}" />
                        <TextBlock Text="{Binding SourceLocation, StringFormat=Quelle: {0}}" />
                        <TextBlock Text="{Binding SimObjectStateDescription}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LinkedObjectDescription}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ExecutionDescription}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ValidationErrorText}" Foreground="#FFC62828" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:ContainerToFeeVisualTreeNodeVM}"
                                  ItemsSource="{Binding Children}">
            <Border Margin="2" Padding="2" CornerRadius="3"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    behaviors:ContainerToFeeVisualDragDropBehavior.IsDropTarget="True"
                    behaviors:ContainerToFeeVisualDragDropBehavior.DropTarget="{Binding}"
                    behaviors:ContainerToFeeVisualDragDropBehavior.DropCommand="{Binding DataContext.DropCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding DisplayBackground}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="3" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSynchronizationMatch}" Value="True">
                                <Setter Property="BorderBrush" Value="#FF0D47A1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
                                <Setter Property="BorderBrush" Value="#FF0D47A1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Löschen"
                                  Command="{Binding PlacementTarget.Tag.DeleteTreeNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="Container im Lauf berücksichtigen / ausschließen"
                                  Command="{Binding PlacementTarget.Tag.ToggleTreeNodeGenerationCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="Mehrfachfund als beabsichtigt bestätigen"
                                  Command="{Binding PlacementTarget.Tag.ConfirmDuplicateFeeObjectCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox Margin="0,0,6,0"
                          Grid.RowSpan="2"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsGenerationSelected, Mode=TwoWay}"
                          Visibility="{Binding CanSelectGeneration, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ToolTip="Diesen vollständigen Container bei Generierung bzw. Link-only berücksichtigen" />
                <CheckBox Margin="0,0,6,0" Grid.RowSpan="2" VerticalAlignment="Center"
                          IsChecked="{Binding WillGenerateObject, Mode=OneWay}"
                          IsHitTestVisible="False" Focusable="False"
                          Visibility="{Binding ShowGenerationAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ToolTip="{Binding GenerationActionText}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,1,0,0">
                    <TextBlock FontSize="10" Foreground="#FF356A88"
                               Text="{Binding LinkedObjectDescription}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#FF5A3C00"
                               Text="{Binding GenerationActionText}"
                               Visibility="{Binding ShowGenerationAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.RowSpan="2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button Padding="5,1" Content="Mehrfachfund bestätigen"
                            Command="{Binding DataContext.ConfirmDuplicateFeeObjectCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding CanConfirmDuplicate, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Bestätigt diesen konkreten FEE-Treffer. Bei Single-Select wird er eindeutig ausgewählt; bei Multi-Select bleiben die Mehrfachzuordnungen erhalten." />
                    <TextBlock FontSize="10" Foreground="#FF2E7D32" Text="Mehrfachfund bestätigt"
                               Visibility="{Binding IsDuplicateConfirmed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <Border Grid.Column="3" Grid.RowSpan="2" Margin="8,0,0,0" Padding="4,1" CornerRadius="3"
                        Background="#1A000000">
                    <TextBlock Text="{Binding DisplayTypeLabel}" FontSize="10" Foreground="#666666" />
                </Border>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTechnical}" Value="True">
                                <Setter Property="Opacity" Value="0.68" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,10,6" MinHeight="30"
                         IsReadOnly="True" VerticalContentAlignment="Center"
                         Text="{Binding SourceXmlPath, Mode=OneWay, TargetNullValue=Container-XML auswählen}" />

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource VisualToolbarButton}" Content="XML öffnen"
                            Command="{Binding OpenXmlCommand}" />
                    <Button Style="{StaticResource VisualToolbarButton}" Content="Plan laden"
                            Command="{Binding LoadPlanCommand}" />
                    <Button Style="{StaticResource VisualToolbarButton}" Content="Plan speichern"
                            Command="{Binding SavePlanCommand}" />
                    <Button Style="{StaticResource VisualToolbarButton}" Content="Container.xml speichern"
                            Command="{Binding SaveContainerXmlCommand}"
                            ToolTip="Speichert den für die Generierung wirksamen Stand mit Slotkorrekturen, ergänzten Signalen und aktuell ausgewählten Containern." />
                    <Button Style="{StaticResource VisualToolbarButton}" Content="Hilfe / Anleitung"
                            Command="{Binding OpenDocumentationCommand}"
                            ToolTip="Öffnet die mit der Anwendung ausgelieferte Container2FEE-Visual-Anleitung einschließlich Bedienablauf, Statusfarben, Drag-and-drop-Regeln und technischen Grenzen." />
                </StackPanel>

                <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                    <Button Style="{StaticResource VisualToolbarButton}" Content="ContainerFiles vergleichen" Command="{Binding CompareContainerFilesCommand}" />
                    <Button Style="{StaticResource VisualToolbarButton}" Content="Rückgängig"
                            Command="{Binding UndoCommand}" />
                    <Button Style="{StaticResource VisualToolbarButton}" Content="Wiederholen"
                            Command="{Binding RedoCommand}" />
                    <Button Style="{StaticResource VisualToolbarButton}" Content="FEE aktualisieren"
                            Command="{Binding RefreshFeeObjectsCommand}"
                            ToolTip="{Binding RefreshFeeObjectsUnavailableReason}"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button Style="{StaticResource VisualToolbarButton}" Content="Automatisch zuordnen"
                            Command="{Binding AutoAssignCommand}"
                            ToolTip="Ordnet freie Ziele nach identischem Komponentenname und kompatiblem FEE-Typ zu." />
                    <Button Style="{StaticResource VisualToolbarButton}" Content="Abbrechen"
                            Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource VisualToolbarButton}" MinWidth="185"
                            Content="SDK-Aufruf isolieren"
                            Command="{Binding HardAbortFeeCommand}"
                            ToolTip="Nur bei blockierendem SDK-Aufruf: gibt die Oberfläche frei und versucht die FEE-Verbindung höchstens zwei Sekunden lang zu trennen. Der öffentliche Remote-SDK kann einen bereits laufenden In-Process-Aufruf nicht hart beenden; dafür muss die Anwendung geschlossen werden. Keine Rücknahme bereits erfolgter Änderungen." />
                    <Button Style="{StaticResource VisualToolbarButton}" Content="Letzten Lauf reparieren"
                            Command="{Binding ResumeLastGenerationCommand}"
                            ToolTip="Wählt anhand des letzten Vorher-/Nachher-Manifests nur fehlgeschlagene oder offene Container erneut aus." />

                    <Button Style="{StaticResource VisualToolbarButton}" Content="Alle selektieren"
                            Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource VisualToolbarButton}" Content="Alle deselektieren"
                            Command="{Binding DeselectAllCommand}" />

                    <Separator Margin="8,0" />

                    <Button MinWidth="150" MinHeight="32" Padding="12,4"
                            Content="Start Generation"
                            Command="{Binding StartGenerationCommand}"
                            ToolTip="{Binding StartGenerationUnavailableReason}"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button MinWidth="205" MinHeight="32" Margin="6,0,0,0" Padding="12,4"
                            Content="Nur SimObjects verknüpfen"
                            Command="{Binding LinkOnlyCommand}"
                            ToolTip="{Binding LinkOnlyUnavailableReason}"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button MinWidth="190" MinHeight="32" Margin="6,0,0,0" Padding="12,4"
                            Content="Nur Signale verknüpfen"
                            Command="{Binding LinkSignalsOnlyCommand}"
                            ToolTip="{Binding LinkSignalsOnlyUnavailableReason}"
                            ToolTipService.ShowOnDisabled="True" />
                </WrapPanel>
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,7,0,0"
                           Foreground="#FF245B78" Text="{Binding FeeRefreshHint}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                           Foreground="#FF5A3C00" Text="{Binding LastManifestSummary}" TextWrapping="Wrap"
                           ToolTip="{Binding LastManifestPath}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,8,0,0" Padding="8" CornerRadius="4"
                Background="#FFF4CE" BorderBrush="#FFCA64" BorderThickness="1">
            <TextBlock Text="Keine Verbindung zu FEE vorhanden. XML-Vorschau und Planbearbeitung sind verfügbar; FEE-Objekte und Generierung erst nach erfolgreicher Verbindung."
                       TextWrapping="Wrap" />
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Connection.CanUseFeeFeatures}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,8" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1.25*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1.7*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="10" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource VisualPanelHeader}" Text="Container- und Objektstruktur" />
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="175" />
                        </Grid.ColumnDefinitions>
                        <TextBox MinHeight="29" Text="{Binding TreeFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nach Name, Typ oder Slot filtern" />
                        <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding TreeStatusFilters}"
                                  SelectedItem="{Binding SelectedTreeStatusFilter}" DisplayMemberPath="DisplayName"
                                  ToolTip="Containerbaum nach Ausführungs- und Verknüpfungszustand filtern" />
                        <ComboBox Grid.Column="2" Margin="6,0,0,0" ItemsSource="{Binding TreeSortOptions}"
                                  SelectedItem="{Binding SelectedTreeSort}" DisplayMemberPath="DisplayName"
                                  ToolTip="Container nach Typ oder Name sortieren" />
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,7">
                        <Button Content="Alles aufklappen" Command="{Binding ExpandAllCommand}" Padding="8,2" />
                        <Button Content="Alles zuklappen" Command="{Binding CollapseAllCommand}" Padding="8,2" Margin="5,0,0,0" />
                        <CheckBox Margin="12,0,0,0" VerticalAlignment="Center"
                                  Content="Auswahl in Listen und Baum synchronisieren"
                                  IsChecked="{Binding SynchronizeRelatedSelections}"
                                  ToolTip="Springt beim Auswählen eines Signals, SimObjects oder Validierungseintrags zum zugehörigen Baumknoten – und umgekehrt." />
                    </StackPanel>
                    <TreeView Grid.Row="3" ItemsSource="{Binding TreeRoots}"
                              ItemContainerStyle="{StaticResource VisualTreeItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              behaviors:ContainerToFeeVisualTreeSelectionBehavior.IsEnabled="True"
                              behaviors:ContainerToFeeVisualTreeSelectionBehavior.RevealEnabled="{Binding SynchronizeRelatedSelections}"
                              behaviors:ContainerToFeeVisualTreeSelectionBehavior.DeleteCommand="{Binding DeleteTreeNodeCommand}"
                              behaviors:ContainerToFeeVisualTreeSelectionBehavior.SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}" />
                    <WrapPanel Grid.Row="4" Margin="0,7,0,0"
                               ToolTip="Farben werden für Signale, SimObjects und ihre übergeordneten Strukturknoten gleich ausgewertet.">
                        <Border Width="13" Height="13" Background="#FFC6EFCE"/><TextBlock Margin="3,0,8,0" FontSize="10" Text="gültig"/>
                        <Border Width="13" Height="13" Background="#FFE8D9F3"/><TextBlock Margin="3,0,8,0" FontSize="10" Text="Verknüpfung fehlt"/>
                        <Border Width="13" Height="13" Background="#FFFFF2CC"/><TextBlock Margin="3,0,8,0" FontSize="10" Text="wird erzeugt"/>
                        <Border Width="13" Height="13" Background="#FFEF9A9A"/><TextBlock Margin="3,0,0,0" FontSize="10" Text="Fehler"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Padding="10" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource VisualPanelHeader}" Margin="0"
                                       Text="{Binding SelectedTreeNode.Name, TargetNullValue=Kein Container gewählt}" />
                            <TextBlock Foreground="#666666" FontSize="11">
                                <Run Text="{Binding SelectedTreeNode.TypeName, Mode=OneWay}" />
                                <Run Text="  ·  " />
                                <Run Text="{Binding SelectedTreeNode.Slot, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="Fehlende SimObjects bei der Generierung erzeugen"
                                      IsChecked="{Binding IsCreationRequestedForSelection, Mode=TwoWay}"
                                      Visibility="{Binding SelectedContainerSupportsCreation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      ToolTip="Standardmäßig aktiv. Aus: Ein fehlendes Pflichtziel blockiert den ausgewählten Container." />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Alle" Command="{Binding SelectAllMissingCreationCommand}" Padding="7,2" />
                                <Button Content="Keine" Command="{Binding DeselectAllMissingCreationCommand}" Padding="7,2" Margin="4,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding CanClassifySignalOnlyContainer, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="Signal-only-Container typisieren" />
                            <ComboBox Margin="0,3,0,0" MinHeight="28"
                                      ItemsSource="{Binding SignalOnlyContainerTypes}"
                                      SelectedItem="{Binding SelectedSignalOnlyContainerType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="Wählt einen bekannten Containertyp. Dessen Logik- und SimObject-Ziele werden in den Plan übernommen; die Quell-XML bleibt unverändert, bis Container.xml speichern gewählt wird." />
                        </StackPanel>

                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding SelectedTreeNode.CanEditSlot, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="Erwarteten Slot korrigieren" />
                            <ComboBox Margin="0,3,0,0" MinHeight="28"
                                      ItemsSource="{Binding SelectedTreeNode.AllowedSlots}"
                                      SelectedItem="{Binding SelectedTreeNode.Slot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="Ändert den für Validierung, Verknüpfung und Provenienz verwendeten Slot. Die eingelesene Container-XML wird nicht überschrieben." />
                        </StackPanel>
                    </StackPanel>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Targets}"
                             SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                             behaviors:ListBoxRevealBehavior.RevealItem="{Binding SelectedTarget}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="Black" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="9" CornerRadius="4"
                                        ToolTip="{Binding ToolTipText}"
                                        behaviors:ContainerToFeeVisualDragDropBehavior.IsDropTarget="True"
                                        behaviors:ContainerToFeeVisualDragDropBehavior.DropTarget="{Binding}"
                                        behaviors:ContainerToFeeVisualDragDropBehavior.DropCommand="{Binding DataContext.DropCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{Binding StateBackground}" />
                                            <Setter Property="BorderBrush" Value="#C7D7EA" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSynchronizationMatch}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FF0D47A1" />
                                                    <Setter Property="BorderThickness" Value="3" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FF0D47A1" />
                                                    <Setter Property="BorderThickness" Value="3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock Grid.Column="1" Foreground="#666666" FontSize="11"
                                                       Text="{Binding SelectionMode}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Margin="0,2,0,5" Foreground="#666666" FontSize="11"
                                                   Text="{Binding AllowedTypeName, StringFormat=Erlaubter Typ: {0}}" />
                                        <TextBlock Grid.Row="2" Margin="0,0,0,5" FontSize="11" FontWeight="SemiBold"
                                                   Text="{Binding AssignmentState}" />
                                        <ItemsControl Grid.Row="3" ItemsSource="{Binding Assignments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,2" Padding="7,4" Background="{Binding StateBackground}"
                                                            BorderBrush="#B6C9E0" BorderThickness="1" CornerRadius="3"
                                                            ToolTip="{Binding ToolTipText}"
                                                            behaviors:ContainerToFeeVisualDragDropBehavior.IsDragSource="True">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding FeeObjectName}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding FeeObjectTypeName}" Foreground="#777777" FontSize="10" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" MinWidth="26" MinHeight="24" Margin="6,0,0,0"
                                                                    Content="×" ToolTip="Zuordnung entfernen"
                                                                    Command="{Binding DataContext.RemoveAssignmentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3" Style="{StaticResource VisualPanelHeader}" Margin="0,8,0,4"
                               Text="Signalslots des ausgewählten Containers" />
                    <ListBox Grid.Row="4" ItemsSource="{Binding SignalSlots}" MinHeight="190"
                             SelectedItem="{Binding SelectedSignalSlot, Mode=TwoWay}"
                             behaviors:ListBoxRevealBehavior.RevealItem="{Binding SelectedSignalSlot}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="Black" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="9" CornerRadius="4"
                                        ToolTip="{Binding ToolTipText}"
                                        behaviors:ContainerToFeeVisualDragDropBehavior.IsDropTarget="True"
                                        behaviors:ContainerToFeeVisualDragDropBehavior.DropTarget="{Binding}"
                                        behaviors:ContainerToFeeVisualDragDropBehavior.DropCommand="{Binding DataContext.DropCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{Binding StateBackground}" />
                                            <Setter Property="BorderBrush" Value="#C7D7EA" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSynchronizationMatch}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FF0D47A1" />
                                                    <Setter Property="BorderThickness" Value="3" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FF0D47A1" />
                                                    <Setter Property="BorderThickness" Value="3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Slot}" />
                                            <TextBlock Grid.Column="1" Foreground="#666666" FontSize="11"
                                                       Text="{Binding SelectionMode}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Margin="0,2,0,5" FontSize="11" FontWeight="SemiBold"
                                                   Text="{Binding AssignmentState}" />
                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Assignments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,2" Padding="7,4" Background="{Binding StateBackground}"
                                                            BorderBrush="#B6C9E0" BorderThickness="1" CornerRadius="3"
                                                            ToolTip="{Binding ToolTipText}"
                                                            behaviors:ContainerToFeeVisualDragDropBehavior.IsDragSource="True">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock FontSize="10" Foreground="#666666" Text="{Binding AssignedFeeSignal}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" MinWidth="26" MinHeight="24" Margin="6,0,0,0"
                                                                    Content="×" ToolTip="{Binding RemoveToolTip}"
                                                                    Command="{Binding DataContext.RemoveSignalCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Expander Grid.Row="5" Margin="0,8,0,0" MaxHeight="260"
                              Header="Technische Verknüpfungen (Details)" IsExpanded="False">
                        <Grid MinHeight="190">
                            <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding VisibleEdges}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Description}"/></Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Art" Binding="{Binding Kind, Mode=OneWay}" Width="Auto" MinWidth="80" />
                                <DataGridTextColumn Header="Quelle" Binding="{Binding Source, Mode=OneWay}" Width="2*" MinWidth="120" />
                                <DataGridTextColumn Header="Ziel" Binding="{Binding Target, Mode=OneWay}" Width="2*" MinWidth="120" />
                                <DataGridTextColumn Header="Bedeutung" Binding="{Binding Description, Mode=OneWay}" Width="3*" MinWidth="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                            <TextBlock Grid.Row="1" Margin="0,7,0,3" FontWeight="SemiBold" Text="Vorgangsprotokoll" />
                            <ListBox Grid.Row="2" ItemsSource="{Binding OperationDetails}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="2" TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolTipText}">
                                            <Run Text="{Binding TimestampText, Mode=OneWay}"/><Run Text=" · "/><Run FontWeight="SemiBold" Text="{Binding Category, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Message, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Expander>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="190" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" MinWidth="190" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" MinWidth="190" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="10" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource VisualPanelHeader}" Text="Verfügbare FEE-SimObjects" />
                        <TextBox Grid.Row="1" MinHeight="29" Margin="0,0,0,6"
                                 Text="{Binding FeeObjectFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nach Name oder Typ filtern" />
                        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                            <CheckBox Content="Nur kompatible Objekte"
                                      IsChecked="{Binding ShowOnlyCompatibleFeeObjects}" />
                            <CheckBox Margin="12,0,0,0" Content="Details anzeigen"
                                      IsChecked="{Binding ShowFeeObjectDetails}"
                                      ToolTip="Blendet Live-Verknüpfungen und Plan-Zuordnungen ein oder aus." />
                        </WrapPanel>
                        <ComboBox Grid.Row="3" MinHeight="28" Margin="0,0,0,6"
                                  ItemsSource="{Binding FeeObjectStatusFilters}"
                                  SelectedItem="{Binding SelectedFeeObjectStatusFilter}"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="SimObjects nach Zuordnungszustand filtern" />
                        <ListBox Grid.Row="4" ItemsSource="{Binding FeeObjectsView}"
                                 SelectedItem="{Binding SelectedFeeObject, Mode=TwoWay}"
                                 behaviors:ListBoxRevealBehavior.RevealItem="{Binding SelectedFeeObject}"
                                 SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="Black" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="7,5" Margin="1" CornerRadius="3"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            ToolTip="{Binding AssignmentText}"
                                            behaviors:ContainerToFeeVisualDragDropBehavior.IsDragSource="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding StateBackground}" />
                                                <Setter Property="BorderBrush" Value="{Binding StateBorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSynchronizationMatch}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FF0D47A1" />
                                                        <Setter Property="BorderThickness" Value="3" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FF0D47A1" />
                                                        <Setter Property="BorderThickness" Value="3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="In FEE selektieren – mit Remote-SDK nicht verfügbar"
                                                          IsEnabled="False"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          ToolTip="Die Remote-FEE-API liefert ausgewählte GUIDs, bietet aber keinen Aufruf zum Setzen der Auswahl. Die lokale Host-API verwendet nicht auflösbare Laufzeit-IDs." />
                                                <MenuItem Header="Aus FEE löschen"
                                                          Command="{Binding PlacementTarget.Tag.DeleteFeeObjectCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FeeType}" Foreground="#777777" FontSize="10" />
                                                <TextBlock Text="{Binding DuplicateStateText}" Foreground="{Binding StateForeground}"
                                                           FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ConnectionStateText}" Foreground="{Binding StateForeground}"
                                                           FontSize="10" TextWrapping="Wrap"
                                                           Visibility="{Binding DataContext.ShowFeeObjectDetails, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <ItemsControl ItemsSource="{Binding ConnectionDetails}"
                                                              Visibility="{Binding DataContext.ShowFeeObjectDetails, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="8,1,0,0" FontSize="10" TextWrapping="Wrap">
                                                                <Run Text="• " /><Run Text="{Binding Mode=OneWay}" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding PlanAssignmentText}" Foreground="#444444" FontSize="10"
                                                           TextWrapping="Wrap" MaxHeight="42"
                                                           Visibility="{Binding DataContext.ShowFeeObjectDetails, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Width="68" Height="26" Margin="6,0,0,0"
                                                    VerticalAlignment="Top" Padding="5,2" Content="Löschen"
                                                    Command="{Binding DataContext.DeleteFeeObjectCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding DeleteToolTip}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="5" Margin="0,6,0,0" ToolTip="Farben entsprechen dem Containerbaum; gelb kann in dieser Liste leer sein, da sie nur bereits vorhandene FEE-Objekte enthält.">
                            <Border Width="13" Height="13" Background="#FFC6EFCE"/><TextBlock Margin="3,0,8,0" FontSize="10" Text="gültig"/>
                            <Border Width="13" Height="13" Background="#FFE8D9F3"/><TextBlock Margin="3,0,8,0" FontSize="10" Text="Verknüpfung fehlt"/>
                            <Border Width="13" Height="13" Background="#FFFFC7CE"/><TextBlock Margin="3,0,0,0" FontSize="10" Text="Fehler"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Column="2" Padding="10" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource VisualPanelHeader}" Text="Gefundene FEE-Signale" />
                        <Expander Grid.Row="1" Margin="0,0,0,6" MaxHeight="145"
                                  Header="{Binding SelectedExistingInterfacesSummary}"
                                  ToolTip="Ein oder mehrere vorhandene Interfaces auswählen. Nur deren Signale werden durchsucht und automatisch verknüpft.">
                            <Border Margin="0,4,0,0" Padding="4" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3">
                                <ListBox ItemsSource="{Binding AvailableFeeInterfaces}"
                                         MaxHeight="105"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="2" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Content="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Expander>
                        <TextBox Grid.Row="2" MinHeight="29" Margin="0,0,0,6"
                                  Text="{Binding FeeSignalFilter, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Nach Tag, Adresse/Pfad, Interface oder Datentyp filtern" />
                        <Grid Grid.Row="3" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox MinHeight="28"
                                      ItemsSource="{Binding FeeSignalStatusFilters}"
                                      SelectedItem="{Binding SelectedFeeSignalStatusFilter}"
                                      DisplayMemberPath="DisplayName"
                                      ToolTip="Signale nach Zuordnung, Fehlern oder Duplikaten filtern" />
                            <CheckBox Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                      Content="Details anzeigen" IsChecked="{Binding ShowFeeSignalDetails}"
                                      ToolTip="Blendet Interface, Adresse und erkannte Zuordnung ein oder aus." />
                        </Grid>
                        <ListBox Grid.Row="4" ItemsSource="{Binding FeeSignalsView}"
                                 SelectedItem="{Binding SelectedFeeSignal, Mode=TwoWay}"
                                 behaviors:ListBoxRevealBehavior.RevealItem="{Binding SelectedFeeSignal}"
                                 SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="1" Padding="6,4" CornerRadius="3"
                                            behaviors:ContainerToFeeVisualDragDropBehavior.IsDragSource="True"
                                            ToolTip="{Binding ToolTipText}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding StateBackground}" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="3" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSynchronizationMatch}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FF0D47A1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FF0D47A1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Tag}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="10" Foreground="#666666" Text="{Binding Location}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding DataContext.ShowFeeSignalDetails, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock FontSize="10" Foreground="#777777" Text="{Binding InterfaceName, StringFormat=Interface: {0}}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding DataContext.ShowFeeSignalDetails, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock FontSize="10" Foreground="#FF356A35" Text="{Binding AssignmentText}" TextWrapping="Wrap"
                                                       Visibility="{Binding DataContext.ShowFeeSignalDetails, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="5" Margin="0,6,0,0">
                            <Border Width="13" Height="13" Background="#FFC6EFCE"/><TextBlock Margin="3,0,8,0" FontSize="10" Text="zugewiesen"/>
                            <Border Width="13" Height="13" Background="#FFF3F5F7"/><TextBlock Margin="3,0,8,0" FontSize="10" Text="offen"/>
                            <Border Width="13" Height="13" Background="#FFFFCDD2"/><TextBlock Margin="3,0,0,0" FontSize="10" Text="Fehler"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

                <Expander Grid.Column="4" Header="Validierung" IsExpanded="True" ExpandDirection="Left"
                          ToolTip="Ein-/ausklappbare Validierung neben den gefundenen FEE-Signalen.">
                    <Border Width="310" Padding="8" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                        <ListBox ItemsSource="{Binding Issues}"
                                 SelectedItem="{Binding SelectedIssue, Mode=TwoWay}"
                                 behaviors:ListBoxRevealBehavior.RevealItem="{Binding SelectedIssue}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="6" CornerRadius="3"
                                            ToolTip="{Binding Message}"
                                            ToolTipService.ShowDuration="60000">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFE8F1FA" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="3" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static visual:VisualIssueSeverity.Warning}">
                                                        <Setter Property="Background" Value="#FFFFF2CC" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static visual:VisualIssueSeverity.Error}">
                                                        <Setter Property="Background" Value="#FFFFC7CE" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FF0D47A1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Severity}" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Code}" Foreground="#777777" FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Expander>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ProgressBar Height="7" Minimum="0" Maximum="100"
                         Value="{Binding GenerationProgress, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
            <TextBlock Grid.Row="1" Margin="0,3,0,0" Text="{Binding GenerationProgressText}" TextWrapping="Wrap" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Margin="12,0,0,0" Text="{Binding ContainerCount, StringFormat=Container: {0}}" />
                <TextBlock Margin="12,0,0,0" Text="{Binding SelectedContainerCount, StringFormat=Selektiert: {0}}" />
                <TextBlock Margin="12,0,0,0" Text="{Binding ObjectCount, StringFormat=Objekte: {0}}" />
                <TextBlock Margin="12,0,0,0" Text="{Binding EdgeCount, StringFormat=Links: {0}}" />
                <TextBlock Margin="12,0,0,0" Text="{Binding AssignmentCount, StringFormat=Zuordnungen: {0}}" />
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
