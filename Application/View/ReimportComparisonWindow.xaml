<Window x:Class="VIBN_Tools.Application.View.ReimportComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ContainerGeneration – Änderungsvergleich"
        Width="1320" Height="720" MinWidth="860" MinHeight="440"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Erkannte Änderungen" />
            <TextBlock Margin="0,4,0,0" Text="{Binding ReimportNotice}" TextWrapping="Wrap" />
            <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding PendingReimportSelectionSummary}" />
            <TextBlock Margin="0,3,0,0" Foreground="#FF455A64" TextWrapping="Wrap"
                       Text="Einzelentscheidungen werden nur vorgemerkt. Die Liste bleibt vollständig erhalten, bis 'Auswahl anwenden' oder 'Vorschau verwerfen' gewählt wird." />
            <WrapPanel Margin="0,8,0,0">
                <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" Text="Kriterium:" />
                <ComboBox Width="210" ItemsSource="{Binding ReimportCriteria}"
                          SelectedItem="{Binding SelectedReimportCriterion}" />
                <TextBlock Margin="14,0,5,0" VerticalAlignment="Center" Text="Suche:" />
                <TextBox Width="320" Padding="5,2"
                         Text="{Binding ReimportSearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Durchsucht Signal, bisherigen/neuen Wert, genauen Unterschied und Auswirkung." />
            </WrapPanel>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding PendingReimportChangesView}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#FFFFF3CD" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAccepted}" Value="True">
                            <Setter Property="Background" Value="#FFE8F5E9" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Übernehmen" Binding="{Binding IsAccepted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                <DataGridTextColumn Header="Vorläufige Entscheidung" Binding="{Binding TemporaryDecision}" IsReadOnly="True" Width="190" />
                <DataGridTextColumn Header="Kriterium" Binding="{Binding Category}" IsReadOnly="True" Width="150" />
                <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" IsReadOnly="True" Width="180" />
                <DataGridTextColumn Header="Bisher" Binding="{Binding PreviousValue}" IsReadOnly="True" Width="220" />
                <DataGridTextColumn Header="Neu erkannt" Binding="{Binding DetectedValue}" IsReadOnly="True" Width="220" />
                <DataGridTextColumn Header="Genauer Unterschied" Binding="{Binding ExactDifference}" IsReadOnly="True" Width="2*" />
                <DataGridTextColumn Header="Auswirkung" Binding="{Binding DecisionEffect}" IsReadOnly="True" Width="2*" />
                <DataGridTemplateColumn Header="Einzeln vormerken" Width="225">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Padding="6,2" Content="Vormerken"
                                        Command="{Binding DataContext.AcceptReimportChange, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <Button Margin="5,0,0,0" Padding="6,2" Content="Nicht übernehmen"
                                        Command="{Binding DataContext.RejectReimportChange, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" MinWidth="100" Content="Fenster schließen" Click="Close_Click" />
            <StackPanel Orientation="Horizontal">
                <Button MinWidth="110" Content="Alle auswählen" Command="{Binding SelectAllReimportChanges}" />
                <Button MinWidth="120" Margin="6,0,0,0" Content="Keine auswählen" Command="{Binding SelectNoReimportChanges}" />
                <Button MinWidth="135" Margin="16,0,0,0" Content="Vorschau verwerfen" Command="{Binding CancelReimportSelection}" />
                <Button MinWidth="135" Margin="6,0,0,0" Content="Auswahl anwenden" Command="{Binding ApplyReimportSelection}" FontWeight="SemiBold" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
