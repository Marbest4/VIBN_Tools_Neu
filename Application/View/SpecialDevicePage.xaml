<UserControl x:Class="VIBN_Tools.Application.View.SpecialDevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <CollectionViewSource x:Key="GroupedTiaHardwareRows" Source="{Binding TiaHardwareRows}" IsLiveGroupingRequested="True">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DeviceGroupName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MinHeight="285" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" MinHeight="330" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="SpecialDevices2FEE" />
            <TextBlock Margin="0,4,0,0" Foreground="#FF666666" Text="Manuelle Geräte und TIA-Hardware werden auf einer Seite vorbereitet. Erst die Warteschlange erzeugt Geräte in FEE." TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" MinWidth="480" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.1*" MinWidth="570" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Gerät manuell hinzufügen" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Hersteller" />
                    <ComboBox Grid.Row="0" Grid.Column="1" MinHeight="34" ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding SelectedManufacturer}" />
                    <TextBlock Grid.Row="1" Margin="0,9,0,0" VerticalAlignment="Center" Text="Gerätetyp / Logik" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,9,0,0" MinHeight="34" ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding SelectedDevice}" />
                    <TextBlock Grid.Row="2" Margin="0,9,0,0" VerticalAlignment="Center" Text="Robotertyp" Visibility="{Binding ShowRobotType, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,9,0,0" MinHeight="34" ItemsSource="{Binding RobotTypes}" SelectedItem="{Binding SelectedRobotType}" Visibility="{Binding ShowRobotType, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Grid.Row="3" Margin="0,9,0,0" VerticalAlignment="Center" Text="Präfix" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,9,0,0" MinHeight="34" IsEnabled="{Binding IsEnabledDevicePrefix}" Text="{Binding DevicePrefix, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Margin="0,9,0,0" VerticalAlignment="Center" Text="Byteadressen" />
                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,9,0,0" IsEnabled="{Binding IsEnabledDeviceAddress}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Eingang:" />
                        <TextBox Grid.Column="1" Margin="6,0,15,0" MinHeight="34" Text="{Binding DeviceAddressInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Ausgang:" />
                        <TextBox Grid.Column="3" Margin="6,0,0,0" MinHeight="34" Text="{Binding DeviceAddressOutput, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Button Grid.Row="5" Grid.Column="1" Margin="0,12,0,0" MinHeight="38" Content="Gerät in Warteschlange übernehmen" Command="{Binding AddSpecialDeviceCommand}" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Warteschlange / in FEE erzeugen" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding SpecialDevices}" SelectedIndex="{Binding SelectedDeviceIndex}" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="30" ColumnHeaderHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Präfix" Binding="{Binding QueuePrefix, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Hersteller" Binding="{Binding DeviceManufacturer, Mode=OneWay}" IsReadOnly="True" Width="120" />
                            <DataGridTextColumn Header="Logik" Binding="{Binding DeviceLogicObject.LogicDefinitionName, Mode=OneWay}" IsReadOnly="True" Width="210" />
                            <DataGridTextColumn Header="E-Byte" Binding="{Binding QueueInputByte, UpdateSourceTrigger=LostFocus}" Width="75" />
                            <DataGridTextColumn Header="A-Byte" Binding="{Binding QueueOutputByte, UpdateSourceTrigger=LostFocus}" Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                        <Button MinWidth="155" MinHeight="38" Content="In FEE erzeugen" Command="{Binding CreateSpecialDevicesCommand}" IsEnabled="{Binding CanCreateInFee}" ToolTip="{Binding CreateInFeeUnavailableReason}" ToolTipService.ShowOnDisabled="True" />
                        <Button MinWidth="155" MinHeight="38" Margin="7,0,0,0" Content="FEE2-JSON laden" Command="{Binding LoadReverseSnapshotCommand}" IsEnabled="{Binding CanModifyDeviceQueue}" ToolTip="{Binding DeviceQueueUnavailableReason}" ToolTipService.ShowOnDisabled="True" />
                        <Button MinWidth="135" MinHeight="38" Margin="7,0,0,0" Content="Auswahl entfernen" Command="{Binding DeleteSelectedDevicesCommand}" IsEnabled="{Binding CanModifyDeviceQueue}" ToolTip="{Binding DeviceQueueUnavailableReason}" ToolTipService.ShowOnDisabled="True" />
                        <Button MinWidth="115" MinHeight="38" Margin="7,0,0,0" Content="Alle entfernen" Command="{Binding DeleteAllDevicesCommand}" IsEnabled="{Binding CanModifyDeviceQueue}" ToolTip="{Binding DeviceQueueUnavailableReason}" ToolTipService.ShowOnDisabled="True" />
                        <TextBlock Margin="15,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SpecialDevices.Count, StringFormat={}Anzahl: {0}}" />
                    </WrapPanel>
                    <Grid Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding IsBusyCreateDevices, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ProgressBar Height="9" Minimum="0" Maximum="100" Value="{Binding DeviceGenerationProgress, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Margin="0,4,0,0" Text="{Binding DeviceGenerationProgressText}" TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="3" Header="Hardware aus geöffnetem TIA-Projekt lesen" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" Text="TIA-Version:" />
                    <ComboBox Width="115" MinHeight="34" ItemsSource="{Binding InstalledTiaVersions}" SelectedItem="{Binding SelectedTiaVersion}" />
                    <Button MinWidth="145" MinHeight="34" Margin="7,0,0,0" Content="Mit TIA verbinden" Command="{Binding ConnectTiaCommand}" IsEnabled="{Binding CanConnectTia}" ToolTip="{Binding ConnectTiaUnavailableReason}" ToolTipService.ShowOnDisabled="True" />
                    <Button MinWidth="165" MinHeight="34" Margin="7,0,0,0" Content="TIA trennen / abbrechen" Command="{Binding DisconnectTiaCommand}" IsEnabled="{Binding CanDisconnectTia}" ToolTip="{Binding DisconnectTiaUnavailableReason}" ToolTipService.ShowOnDisabled="True" />
                    <TextBlock Margin="22,0,7,0" VerticalAlignment="Center" Text="PLC:" />
                    <ComboBox Width="260" MinHeight="34" ItemsSource="{Binding TiaPlcs}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTiaPlc}" />
                    <Button MinWidth="105" MinHeight="34" Margin="7,0,0,0" Content="Auswählen" Command="{Binding SelectTiaPlcCommand}" IsEnabled="{Binding CanSelectTiaPlc}" ToolTip="{Binding SelectTiaPlcUnavailableReason}" ToolTipService.ShowOnDisabled="True" />
                    <Button MinWidth="155" MinHeight="34" Margin="7,0,0,0" Content="Hardware auslesen" Command="{Binding ReadTiaHardwareCommand}" IsEnabled="{Binding CanReadTiaHardware}" ToolTip="{Binding ReadTiaHardwareUnavailableReason}" ToolTipService.ShowOnDisabled="True" />
                </WrapPanel>
                <StackPanel Grid.Row="1" Margin="0,8">
                    <TextBlock Foreground="#FF666666" Text="Module sind nach Gerätename gruppiert. Der erste Logikvorschlag entsteht in TiaHardwareDeviceRowVM über konservative Hersteller-/Typregeln aus Gerätename, Gerätetyp, Hersteller, Modulpfad, Typkennung und GSD-Daten. Manuelle Auswahlen werden über den stabilen Hardware-Schlüssel lokal gespeichert und beim nächsten Auslesen bevorzugt wiederhergestellt." TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Foreground="#FF355C7D" Text="{Binding HardwareComparisonText}" TextWrapping="Wrap" />
                </StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Source={StaticResource GroupedTiaHardwareRows}}" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" RowHeight="34" ColumnHeaderHeight="36" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Margin="0,5,0,2" Padding="10,6" Background="#FFD9EAF7" BorderBrush="#FF7AA7C7" BorderThickness="1" CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock Foreground="#FF174A6B" FontSize="15" FontWeight="SemiBold"
                                                       Text="{Binding Items[0].DeviceName, StringFormat={}Gerät: {0}}" />
                                            <TextBlock Margin="0,2,0,0" Foreground="#FF356A8A"
                                                       Text="{Binding Items[0].DeviceType, StringFormat={}Gerätetyp: {0}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Übernehmen" Binding="{Binding Include}" Width="86" />
                        <DataGridTextColumn Header="Hardware-ID" Binding="{Binding HardwareIdentifier, Mode=OneWay}" IsReadOnly="True" Width="110" />
                        <DataGridTextColumn Header="GSDML" Binding="{Binding GsdDisplay, Mode=OneWay}" IsReadOnly="True" Width="175" />
                        <DataGridTextColumn Header="IP-Adresse" Binding="{Binding IpAddress, Mode=OneWay}" IsReadOnly="True" Width="105" />
                        <DataGridTextColumn Header="Modultyp" Binding="{Binding ModuleTypeDisplay, Mode=OneWay}" IsReadOnly="True" Width="190" />
                        <DataGridTextColumn Header="Firmware" Binding="{Binding FirmwareVersion, Mode=OneWay}" IsReadOnly="True" Width="85" />
                        <DataGridTemplateColumn Header="E-Bereich" Width="145">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBox Width="48" MinHeight="26" Text="{Binding InputByte, UpdateSourceTrigger=PropertyChanged}" ToolTip="E-Start bearbeiten" /><TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="{Binding InputAddressRange, Mode=OneWay}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="A-Bereich" Width="145">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBox Width="48" MinHeight="26" Text="{Binding OutputByte, UpdateSourceTrigger=PropertyChanged}" ToolTip="A-Start bearbeiten" /><TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="{Binding OutputAddressRange, Mode=OneWay}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="E-Länge (Byte)" Binding="{Binding InputLength, Mode=OneWay}" IsReadOnly="True" Width="105" />
                        <DataGridTextColumn Header="A-Länge (Byte)" Binding="{Binding OutputLength, Mode=OneWay}" IsReadOnly="True" Width="105" />
                        <DataGridTextColumn Header="Präfix" Binding="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Width="135" />
                        <DataGridTemplateColumn Header="Logik" Width="235">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox MinHeight="27" ItemsSource="{Binding DataContext.HardwareLogicOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedLogic}" ToolTip="Keine Logik auswählen, wenn das Hardwareelement nicht in die Warteschlange übernommen werden soll." /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Zuordnungsquelle" Binding="{Binding MappingSource, Mode=OneWay}" IsReadOnly="True" Width="260" />
                        <DataGridTextColumn Header="Status" Binding="{Binding State, Mode=OneWay}" IsReadOnly="True" Width="105" />
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="3" Margin="0,9,0,0">
                    <Button DockPanel.Dock="Right" MinWidth="285" MinHeight="36" Content="Ausgewählte Geräte in Warteschlange übernehmen" Command="{Binding AddSelectedHardwareDevicesCommand}" />
                    <Button DockPanel.Dock="Right" MinWidth="185" MinHeight="36" Margin="0,0,7,0" Content="Zuordnung speichern" Command="{Binding SaveTiaHardwareMappingCommand}" />
                    <Button DockPanel.Dock="Right" MinWidth="190" MinHeight="36" Margin="0,0,7,0" Content="JSON mit TIA vergleichen" Command="{Binding CompareReverseWithTiaCommand}" />
                    <ProgressBar DockPanel.Dock="Right" Width="125" Height="7" Margin="0,0,14,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsBusyTia, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </DockPanel>
            </Grid>
        </GroupBox>
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="10,7" Background="#FFF3F5F7" CornerRadius="3"><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" /></Border>
    </Grid>
</UserControl>
