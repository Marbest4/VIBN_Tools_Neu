<UserControl x:Class="VIBN_Tools.Application.View.Fee2ContainerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VIBN_Tools.Application.VM"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <UserControl.DataContext>
        <vm:Fee2ContainerPageVM />
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="FEE2Container" />
            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                       Text="Zeigt alle BasicFrames als auswählbare Hauptknoten. Container2FEE-Provenienz ermöglicht einen exakten Round-Trip; bestehende Modelle werden aus unterstützten Objekttypen sowie ihren Signal- und Slotzuordnungen rekonstruiert und mit Prüfhinweisen gekennzeichnet." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,10" Orientation="Horizontal">
            <Button MinWidth="150" MinHeight="34"
                    Content="FEE-Roots einlesen"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding CanRefresh}"
                    ToolTip="{Binding RefreshUnavailableReason}"
                    ToolTipService.ShowOnDisabled="True" />
            <Button Margin="8,0,0,0" MinWidth="165" MinHeight="34"
                    Content="ContainerFile exportieren"
                    Command="{Binding ExportCommand}"
                    IsEnabled="{Binding CanExport}"
                    ToolTip="{Binding ExportUnavailableReason}"
                    ToolTipService.ShowOnDisabled="True" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding SelectionSummary}" />
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="FEE-Root" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="GUID" Binding="{Binding Guid}" Width="2*" />
                <DataGridTextColumn Header="Quelle" Binding="{Binding SourceKind}" Width="2*" />
                <DataGridTextColumn Header="Container" Binding="{Binding ContainerCount}" Width="*" />
                <DataGridTextColumn Header="Signale" Binding="{Binding SignalCount}" Width="*" />
                <DataGridTextColumn Header="Aktuell gelesen" Binding="{Binding UpdatedSignalCount}" Width="*" />
                <DataGridTextColumn Header="Fehlend" Binding="{Binding MissingSignalCount}" Width="*" />
                <DataGridTextColumn Header="Slotrouten" Binding="{Binding UpdatedSlotCount}" Width="*" />
                <DataGridTextColumn Header="Slot ungeklärt" Binding="{Binding UnresolvedSlotCount}" Width="*" />
                <DataGridTextColumn Header="Quellfingerprint" Binding="{Binding Provenance.SourceFingerprint, TargetNullValue=-}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Erkannte Container">
                <DataGrid ItemsSource="{Binding FoundContainers}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Komponente" Binding="{Binding Component}" Width="2*" />
                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="*" />
                        <DataGridTextColumn Header="Zugeordnete Signale" Binding="{Binding AssignedSignalCount}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
            <GroupBox Grid.Column="2" Header="Erkannte Signalzuordnungen">
                <DataGrid ItemsSource="{Binding FoundSignals}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Container" Binding="{Binding Container}" Width="2*" />
                        <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="2*" />
                        <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="2*" />
                        <DataGridTextColumn Header="Adresse/Pfad" Binding="{Binding Address}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding AssignmentState}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <ItemsControl Grid.Row="4" Margin="0,8,0,0" ItemsSource="{Binding Issues}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Foreground="DarkRed" TextWrapping="Wrap" Text="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <ProgressBar Height="7" IsIndeterminate="True">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Text="{Binding StatusText}" />
        </StackPanel>
    </Grid>
</UserControl>
