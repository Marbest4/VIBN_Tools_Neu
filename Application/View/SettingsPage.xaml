<UserControl x:Class="VIBN_Tools.Application.View.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ux="http://Grob.com/wpf.ux"
             xmlns:uxb="http://Grob.com/wpf.ux.behaviors"
             xmlns:local="clr-namespace:VIBN_Tools.Application.View"
             xmlns:g="clr-namespace:VIBN_Tools.GlobalClasses"
             xmlns:vm="clr-namespace:VIBN_Tools.Application.VM"
             xmlns:shared="clr-namespace:VIBN_Tools.SharedWpf;assembly=VIBN_Tools.SharedWpf"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1200">

    <d:UserControl.DataContext>
        <d:DesignInstance Type="vm:SettingsPageVM" IsDesignTimeCreatable="True"/>
    </d:UserControl.DataContext>



    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary  Source="pack://application:,,,/Grob.UX;component/Styles/ScrollBarStyles.xaml"/>-->
                <ResourceDictionary Source="pack://application:,,,/Grob.UX;component/Styles/General.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <g:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrushConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="Both">
        <StackPanel MinWidth="760" Orientation="Vertical">
            <!--Project Settings-->
            <GroupBox Margin="10">
                <GroupBox.Header>
                    <TextBlock Style="{StaticResource H3Style}" Text="Project Settings"/>
                </GroupBox.Header>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <!--<TextBlock Style="{StaticResource TextBlockBaseStyle}" Text="Project Template:"/>-->
                    <ux:ComboBox Watermark="Select Project Template" ItemsSource="{Binding TemplateTypes}" SelectedItem="{Binding SelectedTemplate}" />
                </StackPanel>
            </GroupBox>

            <!--<GroupBox Margin="10">
                <GroupBox.Header>
                    <TextBlock Style="{StaticResource CheckBoxStyle}" Text="Remote &amp; Connection"/>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ux:ComboBox Grid.Row="0" Grid.Column="0" Margin="5" Watermark="Server Name" ItemsSource="{Binding ServerNames}" Text="{Binding ServerName}" IsEditable="{Binding CheckboxUseLocalHostInverted}" IsEnabled="{Binding CheckboxUseLocalHostInverted}" StaysOpenOnEdit="True" IsTextSearchEnabled="True" IsTextSearchCaseSensitive="false"/>
                    <ux:CheckBox Grid.Row="0" Grid.Column="1" Margin="25,5,25,5" Style="{StaticResource CheckBoxSmallStyle}" IsChecked="{Binding CheckboxUseLocalhost}">
                        <TextBlock Text="Use Localhost" Style="{StaticResource CheckBoxStyle}"/>
                    </ux:CheckBox>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                        <ux:ToggleButton Margin="5" ux:Icon.Kind="Reports" ux:Icon.Dock="Right" Content="1  " DebounceInterval="100" IsChecked="{Binding UseDisplay1}"/>
                        <ux:ToggleButton Margin="5" ux:Icon.Kind="Reports" ux:Icon.Dock="Right" Content="2  " DebounceInterval="100" IsChecked="{Binding UseDisplay2}"/>
                        <ux:ToggleButton Margin="5" ux:Icon.Kind="Reports" ux:Icon.Dock="Right" Content="3  " DebounceInterval="100" IsChecked="{Binding UseDisplay3}"/>
                        <ux:ToggleButton Margin="5" ux:Icon.Kind="Reports" ux:Icon.Dock="Right" Content="4  " DebounceInterval="100" IsChecked="{Binding UseDisplay4}"/>
                    </StackPanel>
                    <ux:Button Grid.Row="0" Grid.Column="3" Margin="5" Content="Connect RDP" Command="{Binding ConnectToFee}" Background="{Binding Connection.IsConnected, Converter={StaticResource ConnectionStateToBrushConverter}}"/>

                </Grid>
            </GroupBox>-->

            <GroupBox Margin="10">
                <GroupBox.Header>
                    <TextBlock Style="{StaticResource H3Style}" Text="Simulation (FEE)"/>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ux:ComboBox Grid.Row="0"
                                 Grid.Column="0"
                                 MinHeight="36"
                                 Margin="5"
                                 Watermark="Online-PC eingeben oder auswählen"
                                 ItemsSource="{Binding ServerNames}"
                                 Text="{Binding SelectedServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEditable="True"
                                 StaysOpenOnEdit="True"
                                 IsTextSearchEnabled="False" />
                    <ux:CheckBox Grid.Row="0" Grid.Column="1" Margin="25,5,25,5" Style="{StaticResource CheckBoxSmallStyle}" IsChecked="{Binding CheckboxUseLocalhost}">
                        <TextBlock Text="Use Localhost" Style="{StaticResource TextRobotoLightStyle}"/>
                    </ux:CheckBox>
                    <ux:Button Grid.Row="0" Grid.Column="2" Margin="5" Content="Liste aktualisieren" Command="{Binding RefreshServerList}" />
                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                        <ux:ToggleButton Margin="5,5,0,5" Style="{StaticResource RadToggleButtonStyle}" IsChecked="{Binding LoadFeeData}"/>
                        <TextBlock Margin="0,5,25,5" Text="Load Fee Data on Connect" Style="{StaticResource TextRobotoLightStyle}" VerticalAlignment="Center"/> 
                        <ux:Button Margin="5" Content="  Connect  " Command="{Binding ConnectToFee}" Background="{Binding Connection.IsConnected, Converter={StaticResource ConnectionStateToBrushConverter}}"/>
                        <ux:Button Margin="5" Content="Disconnect" Command="{Binding DisconnectFromFee}" Background="{Binding Connection.IsConnected, Converter={StaticResource ConnectionStateToBrushConverter}}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock  Margin="5,5,5,0" Style="{StaticResource TextRobotoLightStyle}" Text="Connected to:" FontSize="12"/>
                        <TextBlock  Margin="5,0,5,5" Style="{StaticResource TextRobotoLightStyle}" Text="{Binding ConnectedServer}" FontSize="12"/>
                    </StackPanel>

                    <!--<ux:TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Watermark="Path to Container Requirements XML" Text=""  IsReadOnly="True"/>
                    <ux:Button Grid.Row="1" Grid.Column="4" Margin="5" Content="Browse" Command="{Binding }"/>

                    <ux:TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Watermark="Default Backup Path" Text="{Binding Test}" IsReadOnly="True"/>
                    <ux:Button Grid.Row="2" Grid.Column="4" Margin="5" Content="Create Backup" Command="{Binding }"/>-->

                    <Grid Grid.Row="1" Grid.ColumnSpan="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ux:Button Grid.Column="0" Margin="5" Content="Create Project Base" Command="{Binding CreateProjectBase}"/>
                        <!--<ux:Button Grid.Column="1" Margin="5" Content="Test Button" Command="{Binding TestButton}"/>-->
                        <TextBlock Grid.Column="2" Margin="5" Style="{StaticResource TextRobotoLightStyle}" FontSize="12" Text="{Binding FeeObjectStatus}" VerticalAlignment="Bottom"/>

                    </Grid>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Margin="5,4,5,0" Text="{Binding ConnectionStatus}" TextWrapping="Wrap" />
                    <Border Grid.Row="3" Grid.ColumnSpan="5" Margin="5,8,5,5" Padding="10" BorderThickness="1" CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFF5F5F5" />
                                <Setter Property="BorderBrush" Value="#FFD0D0D0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFeeVersionMismatch}" Value="True">
                                        <Setter Property="Background" Value="#FFFFE1E1" />
                                        <Setter Property="BorderBrush" Value="#FFB00020" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding UsedFeeSdkVersion, StringFormat=Verwendete SDK-Version: {0}}" />
                            <TextBlock Margin="0,3,0,0" Text="{Binding InstalledFeeVersion, StringFormat=Neueste vollständige FEE-Version: {0}}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="#FFB00020"
                                       FontWeight="Bold"
                                       Text="{Binding FeeVersionStatus}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasFeeVersionMismatch, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>


            <GroupBox Margin="10">
                <GroupBox.Header>
                    <TextBlock Style="{StaticResource H3Style}" Text="Geschützte Zugangsdaten (Windows Credential Manager)" />
                </GroupBox.Header>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center" Text="FEE-Benutzer" />
                    <TextBox Grid.Row="0" Grid.Column="1" MinHeight="34" Margin="0,3,10,3" Padding="7,4"
                             Text="{Binding FeeUsernameInput, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Benutzername für die FEE-Verbindung; wird zusammen mit dem Passwort geschützt gespeichert." />
                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,5,10,5" VerticalAlignment="Center"
                               FontWeight="SemiBold" Text="{Binding FeeCredentialsStatus}" />
                    <Button Grid.Row="0" Grid.Column="3" MinWidth="90" Margin="0,3" Content="Löschen"
                            Command="{Binding DeleteFeeCredentials}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center" Text="FEE-Passwort" />
                    <PasswordBox Grid.Row="1" Grid.Column="1" MinHeight="34" Margin="0,3,10,3" Padding="7,4"
                                 shared:PasswordBoxBindingBehavior.Password="{Binding FeePasswordInput, Mode=TwoWay}"
                                 ToolTip="Passwort für die FEE-Verbindung; ein leeres Feld verändert vorhandene FEE-Zugangsdaten nicht." />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center" Text="Kanbanize API-Key" />
                    <PasswordBox Grid.Row="2" Grid.Column="1" MinHeight="34" Margin="0,3,10,3" Padding="7,4"
                                 shared:PasswordBoxBindingBehavior.Password="{Binding KanbanizeApiKeyInput, Mode=TwoWay}"
                                 ToolTip="Neuen API-Key eingeben; ein leeres Feld verändert einen vorhandenen Wert nicht." />
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,5,10,5" VerticalAlignment="Center"
                               FontWeight="SemiBold" Text="{Binding KanbanizeApiKeyStatus}" />
                    <Button Grid.Row="2" Grid.Column="3" MinWidth="90" Margin="0,3" Content="Löschen"
                            Command="{Binding DeleteKanbanizeApiKey}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center" Text="Remote-Passwort" />
                    <PasswordBox Grid.Row="3" Grid.Column="1" MinHeight="34" Margin="0,3,10,3" Padding="7,4"
                                 shared:PasswordBoxBindingBehavior.Password="{Binding RemoteDesktopPasswordInput, Mode=TwoWay}"
                                 ToolTip="Passwort für die automatische RDP-Anmeldung; es wird nicht im Protokoll angezeigt." />
                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,5,10,5" VerticalAlignment="Center"
                               FontWeight="SemiBold" Text="{Binding RemoteDesktopPasswordStatus}" />
                    <Button Grid.Row="3" Grid.Column="3" MinWidth="90" Margin="0,3" Content="Löschen"
                            Command="{Binding DeleteRemoteDesktopPassword}" />

                    <Button Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" MinWidth="160" Margin="0,8,10,3"
                            Content="Eingaben speichern" Command="{Binding SaveIntegrationCredentials}" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,7,0,0"
                               Foreground="#FF555555" Text="{Binding CredentialStatus}" TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Margin="10">
                <GroupBox.Header>
                    <TextBlock Style="{StaticResource H3Style}" Text="Lokale Automatisierungsinstallationen" />
                </GroupBox.Header>
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,7">
                        <Button MinWidth="130" Content="Neu erkennen"
                                Command="{Binding RefreshAutomationInstallations}"
                                ToolTip="Liest installierte TIA-/Openness-, WinCC-, Siemens- und TwinCAT-Komponenten erneut ein. Es werden keine Installationen verändert." />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding AutomationDiscoveryStatus}" TextWrapping="Wrap" />
                    </StackPanel>
                    <DataGrid MinHeight="130" MaxHeight="300" MinWidth="1180"
                              ItemsSource="{Binding InstalledAutomationComponents}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              EnableRowVirtualization="True"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kategorie" Binding="{Binding KindLabel}" Width="175" />
                            <DataGridTemplateColumn Header="Produkt / Erweiterung" Width="310">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Product}" ToolTip="{Binding Product}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="125" />
                            <DataGridTemplateColumn Header="Installationspfad" Width="430">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding InstallLocation}" ToolTip="{Binding InstallLocation}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Nachweis" Width="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Evidence}" ToolTip="{Binding Evidence}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>


        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
