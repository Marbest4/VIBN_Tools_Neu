<UserControl x:Class="VIBN_Tools.Application.View.ViCoSearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:VIBN_Tools.Application.Behaviors">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <behaviors:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
        <DataTemplate x:Key="ViCoProjectCardTemplate">
            <TextBlock Margin="2,1" TextWrapping="Wrap" ToolTip="{Binding DateSummary}">
                <Hyperlink IsEnabled="{Binding CanOpenCard}"
                           Command="{Binding Data.OpenKanbanizeCardCommand, Source={StaticResource ViewModelProxy}}"
                           CommandParameter="{Binding}">
                    <Run Text="{Binding Title, Mode=OneWay}" />
                </Hyperlink>
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Zur Kanbanize-Karte springen"
                                  IsEnabled="{Binding PlacementTarget.DataContext.CanOpenCard, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                  Command="{Binding Data.OpenKanbanizeCardCommand, Source={StaticResource ViewModelProxy}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox Grid.Column="0"
                     MinHeight="36"
                     Padding="8,5"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     ToolTip="Mehrere Begriffe mit Komma trennen (UND-Suche), z. B. Motor, Sensor. Begriffe mit ! ausschließen, z. B. Motor, !Alt. Der Suchumfang wird mit der Checkbox festgelegt; die Trefferzeile zeigt die Fundspalten als Tooltip."
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    MinWidth="190"
                    MinHeight="36"
                    Margin="8,0,0,0"
                    FontSize="14"
                    Content="Daten aktualisieren"
                    ToolTip="Aktualisiert Kanbanize-Daten und lädt anschließend den lokalen Cache; ohne API-Zugriff wird nur der Cache geladen."
                    Command="{Binding RefreshCommand}" />
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding AutoRefreshCountdown}" />
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Intervall:" />
                <TextBox Width="58" MinHeight="28" Padding="6,2" VerticalContentAlignment="Center"
                         Text="{Binding AutoRefreshIntervalMinutes, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Zulässig sind 1 bis 1440 Minuten." />
                <TextBlock Margin="5,0,8,0" VerticalAlignment="Center" Text="Minuten" />
                <Button MinWidth="95" MinHeight="28" Padding="8,2" Content="Übernehmen"
                        Command="{Binding SaveAutoRefreshIntervalCommand}" />
                <Menu Margin="18,0,0,0" VerticalAlignment="Center">
                    <MenuItem Header="Spalten ein-/ausblenden"
                              ToolTip="Die Auswahl wird für den aktuellen Windows-Benutzer gespeichert."
                              ItemsSource="{Binding ColumnOptions}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Title}" />
                                <Setter Property="IsCheckable" Value="True" />
                                <Setter Property="StaysOpenOnClick" Value="True" />
                                <Setter Property="IsChecked" Value="{Binding IsVisible, Mode=TwoWay}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </Menu>
                <CheckBox Margin="18,0,0,0"
                          VerticalAlignment="Center"
                          Content="Nur angezeigte Spalten durchsuchen"
                          IsChecked="{Binding SearchVisibleColumnsOnly, Mode=TwoWay}"
                          ToolTip="Aus: Alle fachlichen Daten einschließlich ausgeblendeter Spalten und Kanbanize-Details werden durchsucht. Ein: Nur aktuell eingeblendete Tabellenspalten werden berücksichtigt." />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.25*" MinWidth="430" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" MinWidth="270" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedWorkstation}"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      SelectionChanged="OnWorkstationSelectionChanged"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      FontSize="13.5"
                      MinRowHeight="34"
                      ColumnHeaderHeight="38"
                      HorizontalScrollBarVisibility="Auto"
                      FrozenColumnCount="2">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding SearchMatchSummary}" />
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Remote Desktop"
                                              Command="{Binding ContextConnectRemoteCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.IsOnline, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              ToolTip="Remote Desktop erfordert einen online erreichbaren PC."
                                              ToolTipService.ShowOnDisabled="True" />
                                    <MenuItem Header="RDP mit Anmeldedialog"
                                              Command="{Binding ContextConnectRemoteWithPromptCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.IsOnline, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              ToolTip="Der RDP-Anmeldedialog erfordert einen online erreichbaren PC."
                                              ToolTipService.ShowOnDisabled="True" />
                                    <Separator />
                                    <MenuItem Header="PC-Projektordner"
                                              Command="{Binding ContextOpenPcProjectsCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.IsOnline, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              ToolTip="Der lokale PC-Projektordner erfordert einen online erreichbaren PC."
                                              ToolTipService.ShowOnDisabled="True" />
                                    <MenuItem Header="Simulation (Server)"
                                              Command="{Binding ContextOpenSimulationCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.HasActiveProjects, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <MenuItem Header="PLC-Projekt (Server)"
                                              Command="{Binding ContextOpenCommissioningCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.HasActiveProjects, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <MenuItem Header="Planung (Server)"
                                              Command="{Binding ContextOpenPlanningCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.HasActiveProjects, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Belegung" Width="90" SortMemberPath="Status"
                                            Visibility="{Binding Data.OccupancyColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="3" Padding="5,3" Background="{Binding StatusBackground, Mode=OneWay}" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding Status, Mode=OneWay}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PC" Binding="{Binding PcName, Mode=OneWay}" Width="94" SortMemberPath="PcName"
                                        Visibility="{Binding Data.PcColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <DataGridTemplateColumn Header="Online" Width="82" SortMemberPath="OnlineStatus"
                                            Visibility="{Binding Data.OnlineColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="3" Padding="5,3" Background="{Binding OnlineStatusBackground, Mode=OneWay}" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" Text="{Binding OnlineStatus, Mode=OneWay}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Planung" Width="240" SortMemberPath="PlanningProjectSummary"
                                            Visibility="{Binding Data.PlanningColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding PlanningProjects}"
                                                  ItemTemplate="{StaticResource ViCoProjectCardTemplate}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseCollapsedActiveProjectPresentation}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>
                                    <Expander Header="{Binding PlanningProjectHeader}">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseCollapsedActiveProjectPresentation}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                        <ItemsControl Margin="4,3,2,4" ItemsSource="{Binding PlanningProjects}"
                                                      ItemTemplate="{StaticResource ViCoProjectCardTemplate}" />
                                    </Expander>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="In Arbeit" Width="240" SortMemberPath="WorkingProjectSummary"
                                            Visibility="{Binding Data.WorkingColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding WorkingProjects}"
                                                  ItemTemplate="{StaticResource ViCoProjectCardTemplate}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseCollapsedActiveProjectPresentation}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>
                                    <Expander Header="{Binding WorkingProjectHeader}">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseCollapsedActiveProjectPresentation}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                        <ItemsControl Margin="4,3,2,4" ItemsSource="{Binding WorkingProjects}"
                                                      ItemTemplate="{StaticResource ViCoProjectCardTemplate}" />
                                    </Expander>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Start Planung" Width="220" SortMemberPath="PlanningStartSummary"
                                            Visibility="{Binding Data.PlanningStartColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Margin="2" Text="{Binding PlanningStartSummary}" TextWrapping="Wrap" ToolTip="{Binding PlanningStartSummary}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Ende Planung" Width="220" SortMemberPath="PlanningEndSummary"
                                            Visibility="{Binding Data.PlanningEndColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Margin="2" Text="{Binding PlanningEndSummary}" TextWrapping="Wrap" ToolTip="{Binding PlanningEndSummary}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Start In Arbeit" Width="220" SortMemberPath="WorkingStartSummary"
                                            Visibility="{Binding Data.WorkingStartColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Margin="2" Text="{Binding WorkingStartSummary}" TextWrapping="Wrap" ToolTip="{Binding WorkingStartSummary}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Ende In Arbeit" Width="220" SortMemberPath="WorkingEndSummary"
                                            Visibility="{Binding Data.WorkingEndColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Margin="2" Text="{Binding WorkingEndSummary}" TextWrapping="Wrap" ToolTip="{Binding WorkingEndSummary}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Abgeschlossene Projekte" Width="230" SortMemberPath="AdditionalProjects"
                                            Visibility="{Binding Data.CompletedColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding CompletedProjectHeader, Mode=OneWay}"
                                          ToolTip="{Binding AdditionalProjects, Mode=OneWay}">
                                    <ItemsControl Margin="4,3,2,4"
                                                  ItemsSource="{Binding CompletedProjects, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,1"
                                                           Text="{Binding}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Software" Width="175" SortMemberPath="ConfigurationSoftware"
                                            Visibility="{Binding Data.SoftwareColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ConfigurationSoftware, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigurationSoftware, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Benutzer" Binding="{Binding UserName, Mode=OneWay}" Width="150" SortMemberPath="UserName"
                                        Visibility="{Binding Data.UserColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <DataGridTextColumn Header="Standort" Binding="{Binding ConfigurationLocation, Mode=OneWay}" Width="135" SortMemberPath="ConfigurationLocation"
                                        Visibility="{Binding Data.LocationColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <DataGridTemplateColumn Header="Sonstiges"
                                            Width="170"
                                            SortMemberPath="ConfigurationOther"
                                            Visibility="{Binding Data.OtherColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ConfigurationOther, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigurationOther, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Projekt-IP"
                                        Binding="{Binding ConfigurationProjectIp, Mode=OneWay}"
                                        Width="130"
                                        SortMemberPath="ConfigurationProjectIp"
                                        Visibility="{Binding Data.ProjectIpColumn.IsVisible, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#FFD0D5DC" ShowsPreview="True" />

            <ScrollViewer Grid.Column="2" Padding="12,0,4,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel TextBlock.FontSize="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedWorkstation.DisplayName, Mode=OneWay}" TextWrapping="Wrap" />

                    <Border Margin="0,8,0,0" Padding="7,4" Background="{Binding SelectedWorkstation.StatusBackground, Mode=OneWay}" CornerRadius="3">
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedWorkstation.Status, Mode=OneWay}" />
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" FontWeight="SemiBold" Text="Remote-Benutzer:" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRemoteUser, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,8,0" FontWeight="SemiBold" Text="RDP-Sitzung:" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" Text="{Binding SelectedWorkstation.RemoteSessionStatus, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5,8,0" FontWeight="SemiBold" Text="Letzte Anmeldung:" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,5,0,0" Text="{Binding SelectedWorkstation.LastRemoteLogon, Mode=OneWay}" TextWrapping="Wrap" />
                    </Grid>

                    <Border Margin="0,10,0,0" Padding="8" Background="#FFF3F5F7" CornerRadius="3">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="Arbeitsplatz-Konfiguration" />
                                <Button DockPanel.Dock="Right"
                                        MinWidth="105"
                                        Content="Speichern"
                                        Command="{Binding SaveConfigurationCommand}"
                                        IsEnabled="{Binding CanEditConfiguration}"
                                        ToolTip="{Binding EditConfigurationUnavailableReason}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Visibility="{Binding HasSelectedConfigurationCard, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button DockPanel.Dock="Right"
                                        Margin="0,0,6,0"
                                        MinWidth="150"
                                        Content="Standardkarte anlegen"
                                        Command="{Binding CreateConfigurationCommand}"
                                        IsEnabled="{Binding CanCreateConfiguration}"
                                        ToolTip="{Binding CreateConfigurationUnavailableReason}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Visibility="{Binding IsSelectedConfigurationMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </DockPanel>
                            <TextBlock Margin="0,4,0,7" FontSize="12.5" Foreground="#FF666666" Text="USER, STANDORT, SW, PROJEKT-IP und SONSTIGES werden als standardisierte Unteraufgaben gespeichert. Fehlende Unteraufgaben werden beim Speichern ergänzt." TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding ConfigurationFields}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      EnableRowVirtualization="True"
                                      HeadersVisibility="Column"
                                      MinHeight="155"
                                      MaxHeight="230">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Feld" Binding="{Binding Key, Mode=OneWay}" IsReadOnly="True" Width="115" />
                                    <DataGridTemplateColumn Header="Wert" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox MinHeight="28"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="False"
                                                         ToolTip="Enter speichert alle geänderten Werte direkt in der Kanbanize-Konfigurationskarte."
                                                         behaviors:EnterKeyCommandBehavior.Command="{Binding DataContext.SaveConfigurationCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Alle Karten dieser Arbeitsplatz-Lane" />
                    <ComboBox MinHeight="36" Padding="7,4" FontSize="14" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,8,0" FontWeight="SemiBold" Text="Projektstart:" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedProjectStart, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Margin="0,4,8,0" FontWeight="SemiBold" Text="Projektende:" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Text="{Binding SelectedProjectEnd, Mode=OneWay}" />
                    </Grid>

                    <TextBox Margin="0,12,0,0"
                             Padding="6"
                             FontFamily="Consolas"
                             FontSize="12.5"
                             IsReadOnly="True"
                             BorderThickness="1"
                             Text="{Binding PathInformation, Mode=OneWay}"
                             TextWrapping="Wrap"
                             ToolTip="Die Pfade können markiert und mit Strg+C kopiert werden." />

                    <StackPanel Visibility="{Binding HasSelectedWorkstation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Monitore" />
                        <WrapPanel>
                            <CheckBox Content="1" IsChecked="{Binding UseMonitor1}" />
                            <CheckBox Margin="12,0,0,0" Content="2" IsChecked="{Binding UseMonitor2}" IsEnabled="{Binding HasMonitor2}" ToolTip="Dieser Monitor ist für den ausgewählten PC nicht verfügbar." ToolTipService.ShowOnDisabled="True" />
                            <CheckBox Margin="12,0,0,0" Content="3" IsChecked="{Binding UseMonitor3}" IsEnabled="{Binding HasMonitor3}" ToolTip="Dieser Monitor ist für den ausgewählten PC nicht verfügbar." ToolTipService.ShowOnDisabled="True" />
                            <CheckBox Margin="12,0,0,0" Content="4" IsChecked="{Binding UseMonitor4}" IsEnabled="{Binding HasMonitor4}" ToolTip="Dieser Monitor ist für den ausgewählten PC nicht verfügbar." ToolTipService.ShowOnDisabled="True" />
                        </WrapPanel>

                        <UniformGrid Margin="0,10,0,0" Columns="2">
                            <Button MinHeight="36" Margin="0,3,3,3" Content="Remote Desktop" ToolTip="{Binding RemoteActionUnavailableReason}" IsEnabled="{Binding CanUseRemoteActions}" Command="{Binding ConnectRemoteCommand}" />
                            <Button MinHeight="36" Margin="3" Content="RDP mit Anmeldedaten" ToolTip="{Binding RemoteActionUnavailableReason}" IsEnabled="{Binding CanUseRemoteActions}" Command="{Binding ConnectRemoteWithPromptCommand}" />
                            <Button MinHeight="36" Margin="0,3,3,3" Content="PC-Projektordner" ToolTip="{Binding PcProjectsUnavailableReason}" IsEnabled="{Binding CanOpenPcProjects}" Command="{Binding OpenPcProjectsCommand}" />
                            <Button MinHeight="36" Margin="3" Content="Simulation" ToolTip="{Binding ServerPathActionUnavailableReason}" IsEnabled="{Binding CanOpenServerPathActions}" Command="{Binding OpenSimulationCommand}" />
                            <Button MinHeight="36" Margin="0,3,3,3" Content="PLC-Projekt" ToolTip="{Binding ServerPathActionUnavailableReason}" IsEnabled="{Binding CanOpenServerPathActions}" Command="{Binding OpenCommissioningCommand}" />
                            <Button MinHeight="36" Margin="3" Content="Planung" ToolTip="{Binding ServerPathActionUnavailableReason}" IsEnabled="{Binding CanOpenServerPathActions}" Command="{Binding OpenPlanningCommand}" />
                        </UniformGrid>
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0"
                               Foreground="#FF8A3B3B"
                               Visibility="{Binding IsSelectedWorkstationOffline, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Text="Der PC ist offline: RDP und PC-Projektordner sind deaktiviert; erreichbare Serverpfade bleiben verfügbar." />

                    <Expander Margin="0,14,0,0" Header="Relevante Kanbanize-Projektkarten (inkl. Backlog / Abschluss)">
                        <ItemsControl ItemsSource="{Binding SelectedWorkstation.RelevantKanbanizeDetails, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Kartenstatus:" />
            <Border Margin="8,0,0,0" Padding="7,3" Background="#FFE3E7ED" CornerRadius="3"><TextBlock Text="Backlog" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFFFF2CC" CornerRadius="3"><TextBlock Text="Planung" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFDDEBF7" CornerRadius="3"><TextBlock Text="In Arbeit" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFE2F0D9" CornerRadius="3"><TextBlock Text="Erledigt" /></Border>
            <Border Margin="16,0,0,0" Padding="7,3" Background="#FFE2F0D9" CornerRadius="3"><TextBlock Text="Frei: nur Backlog/Erledigt" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFFCE4D6" CornerRadius="3"><TextBlock Text="Belegt: Planung/In Arbeit" /></Border>
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FF666666" Text="Online = grün, Offline = rot. RDP-Informationen sind bei fehlender Berechtigung als „Nicht abrufbar“ gekennzeichnet." />
        </WrapPanel>
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock FontSize="13.5" Text="{Binding StatusText}" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="12.5"
                       Foreground="#FF666666"
                       Text="Remote-FEE-Version: nicht zuverlässig direkt abrufbar. Eine verwaltete Angabe kann unter KONFIGURATION → SW gepflegt werden."
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
