<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>VIBN_Tools_IBN</AssemblyName>
    <RootNamespace>VIBN_Tools.IbnRemote</RootNamespace>
    <ApplicationTitle>VIBN Tools IBN Remote</ApplicationTitle>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VIBN_Tools.Core\VIBN_Tools.Core.csproj" />
    <ProjectReference Include="..\VIBN_Tools.IbnRemote.Infrastructure\VIBN_Tools.IbnRemote.Infrastructure.csproj" />
    <ProjectReference Include="..\SharedWpf\VIBN_Tools.SharedWpf.csproj" />
  </ItemGroup>
</Project>
