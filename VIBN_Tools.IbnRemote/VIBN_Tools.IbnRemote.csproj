<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>VIBN_Tools_IBN</AssemblyName>
    <RootNamespace>VIBN_Tools.IbnRemote</RootNamespace>
    <ApplicationTitle>VIBN Tools IBN Remote</ApplicationTitle>
    <Version>$(VibnToolsVersion)</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseAppHost>true</UseAppHost>
    <IbnRemoteInWorkFilter Condition="'$(IbnRemoteInWorkFilter)' == ''"></IbnRemoteInWorkFilter>
    <!-- Deliberately invalid demonstration values requested for the prepared
         IBN executable. Never replace these defaults with production secrets:
         assembly metadata can be read from the published executable. -->
    <IbnRemoteApiKey Condition="'$(IbnRemoteApiKey)' == ''">12345</IbnRemoteApiKey>
    <IbnRemoteRemoteDesktopPassword Condition="'$(IbnRemoteRemoteDesktopPassword)' == ''">67890</IbnRemoteRemoteDesktopPassword>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="IbnRemoteInWorkFilter" Value="$(IbnRemoteInWorkFilter)" />
    <AssemblyMetadata Include="IbnRemoteApiKey" Value="$(IbnRemoteApiKey)" />
    <AssemblyMetadata Include="IbnRemoteRemoteDesktopPassword" Value="$(IbnRemoteRemoteDesktopPassword)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VIBN_Tools.Core\VIBN_Tools.Core.csproj" />
    <ProjectReference Include="..\VIBN_Tools.IbnRemote.Infrastructure\VIBN_Tools.IbnRemote.Infrastructure.csproj" />
    <ProjectReference Include="..\SharedWpf\VIBN_Tools.SharedWpf.csproj" />
  </ItemGroup>
</Project>
