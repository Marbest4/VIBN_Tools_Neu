<Window x:Class="VIBN_Tools.IbnRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VIBN Tools – IBN Remote"
        Width="1120" Height="620" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                       FontSize="20" FontWeight="SemiBold" Text="IBN Remote · Nur Lesen" />
            <Button DockPanel.Dock="Right" MinWidth="105" Height="32" Margin="8,0,0,0"
                    Content="Aktualisieren" Command="{Binding RefreshCommand}" />
            <TextBlock Margin="12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="#FF666666" Text="{Binding SourceStatus}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border Grid.Row="1" Margin="0,0,0,8" Padding="8,5" Background="#FFE9F2FB" CornerRadius="3">
            <TextBlock Text="{Binding FilterDescription}" TextWrapping="Wrap"
                       ToolTip="Der Filter wird beim Publish fest in die EXE-Metadaten geschrieben und ausschließlich auf Projektkarten mit Status 'In Arbeit' angewendet." />
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Results}"
                  SelectedItem="{Binding SelectedWorkstation}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  RowHeight="32"
                  ColumnHeaderHeight="34"
                  FrozenColumnCount="1"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PC" Binding="{Binding PcName}" Width="125" />
                <DataGridTemplateColumn Header="Online" Width="82">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Margin="3" Padding="5,2" Background="{Binding OnlineBackground}" CornerRadius="3">
                                <TextBlock HorizontalAlignment="Center" Text="{Binding OnlineStatus}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="In Arbeit (Projekt)" Binding="{Binding WorkingProjects}" Width="2*" MinWidth="230" />
                <DataGridTextColumn Header="Ende In Arbeit" Binding="{Binding WorkingEnd}" Width="130" />
                <DataGridTextColumn Header="Standort" Binding="{Binding Location}" Width="140" />
                <DataGridTextColumn Header="Sonstiges" Binding="{Binding Other}" Width="*" MinWidth="150" />
                <DataGridTextColumn Header="Software" Binding="{Binding Software}" Width="*" MinWidth="170" />
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="3" Margin="0,9,0,0">
            <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Monitore:" />
            <CheckBox Content="1" IsChecked="{Binding UseMonitor1}" />
            <CheckBox Margin="10,0,0,0" Content="2" IsChecked="{Binding UseMonitor2}" IsEnabled="{Binding HasMonitor2}" />
            <CheckBox Margin="10,0,0,0" Content="3" IsChecked="{Binding UseMonitor3}" IsEnabled="{Binding HasMonitor3}" />
            <CheckBox Margin="10,0,16,0" Content="4" IsChecked="{Binding UseMonitor4}" IsEnabled="{Binding HasMonitor4}" />
            <Button MinWidth="170" MinHeight="32" Content="Remote Desktop starten"
                    Command="{Binding ConnectAutomaticCommand}"
                    CommandParameter="{Binding SelectedWorkstation}"
                    IsEnabled="{Binding SelectedWorkstation.CanConnect}"
                    ToolTip="Verwendet automatisch den Benutzer der KONFIGURATION-Karte und den in dieser Test-EXE eingebetteten RDP-Platzhalter." />
        </WrapPanel>

        <Border Grid.Row="4" Margin="0,8,0,0" Padding="8,5" Background="#FFF3F5F7" CornerRadius="3">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
